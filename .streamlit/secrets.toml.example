# 이 파일을 복사해 Streamlit Cloud > App settings > Secrets 칸에 붙여넣고 값을 채우세요.
# (로컬에서 쓰려면 .streamlit/secrets.toml 로 저장. 이 파일은 깃에 올라가지 않습니다.)

admin_password = "여기에-관리자-비밀번호"

# 구글 시트 주소 https://docs.google.com/spreadsheets/d/<이 부분>/edit 의 <이 부분>
sheet_id = "1AbCdEf...."

# 구글 클라우드 서비스 계정 JSON 키의 내용을 그대로 옮깁니다.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@xxx.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
